FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Run in simulated client worker mode
CMD ["python", "-c", "import time; print('[Edge Client Node] Online and listening for coordinator rounds...'); time.sleep(3600)"]
